<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework, Nullable e ImplicitUsings vêm de Directory.Build.props (raiz do projeto). -->
  <PropertyGroup>
    <RootNamespace>Avarias.Api</RootNamespace>
    <UserSecretsId>436ca7b2-727d-4997-8dde-421aae17ada1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>

  <!-- As fotos enviadas nunca entram na publicação. -->
  <ItemGroup>
    <Content Remove="uploads\**" />
    <None Remove="uploads\**" />
  </ItemGroup>

</Project>
